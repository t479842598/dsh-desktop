{
  "dsh": {
    "command": [
      "npx",
      "@deepseek-ai/dsh",
      "web"
    ],
    "cwd": "",
    "port": 3080,
    "ready_timeout_sec": 60,
    "headless_command": [
      "npx",
      "@deepseek-ai/dsh"
    ]
  },
  "poll_interval_sec": 300,
  "notify": {
    "enabled": true
  },
  "repos": [
    {
      "name": "my-repo",
      "local_path": "/path/to/your/repo",
      "remote": "origin",
      "branch": "master",
      "auto_pull": "ff-only",
      "rebuild": {
        "mode": "off",
        "command": "pnpm install && pnpm run build",
        "prompt": "",
        "retry_on_failure": true
      }
    }
  ],
  "remote": {
    "enabled": true,
    "port": 3081,
    "username": "your-username",
    "password": "your-password",
    "allowed_hosts": [
      "dsh.example.com:3081"
    ]
  },
  "connection": {
    "mode": "local",
    "remote": {
      "url": "",
      "username": "",
      "password": ""
    }
  }
}
